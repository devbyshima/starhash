<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>StarHash</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>rw</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.fulltimestudio.starhash</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>starhash</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>StarHash uses the camera to scan a QR code, to see who to pay. Nothing is recorded or kept.</string>
	<key>NSContactsUsageDescription</key>
	<string>StarHash shows your contacts so you can pick who to pay. They stay on your iPhone.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>StarHash asks for Face ID to open, when you turn it on in Settings, so only you see your payments.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>StarHash notes where you pay, to suggest who you paid when you are back there and to show each payment on a map. It stays on your iPhone.</string>
	<key>StarHashAppGroup</key>
	<string>$(STARHASH_APP_GROUP)</string>
	<key>StarHashChannel</key>
	<string>$(STARHASH_CHANNEL)</string>
	<key>UIAppFonts</key>
	<array>
		<string>SpaceGrotesk.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
