          }
        }
      }
    },
    "Every payment, logged": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Buri bwishyu, bwanditswe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque paiement, enregistré"
          }
        }
      }
    },
    "Everything in this file is already in StarHash.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibiri muri iyi dosiye byose bisanzwe biri muri StarHash."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que contient ce fichier est déjà dans StarHash."
          }
        }
      }
    },
    "Everything stays on this iPhone": {
      "localizations": {
