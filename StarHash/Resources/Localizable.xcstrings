    "Fees and balance won't fill in": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibiguzi n'amafaranga asigaye ntibizuzuzwa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frais et le solde ne se rempliront pas"
          }
        }
      }
    },
    "Fees and your balance fill in by themselves.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibiguzi n'amafaranga asigaye byiyuzuza ubwabyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frais et votre solde se remplissent d'eux-mêmes."
          }
        }
      }
    },
    "Flags": {
      "localizations": {
