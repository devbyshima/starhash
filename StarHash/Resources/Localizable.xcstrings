            "state": "translated",
            "value": "Abana"
          }
        }
      }
    },
    "Choose **Run Immediately**, turn off **Notify When Run**, tap **Next** and pick **StarHash SMS**.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitamo **Run Immediately**, uzimye **Notify When Run**, ukande **Next** maze uhitemo **StarHash SMS**."
          }
        }
      }
    },
    "Choose a face that is you. You can change it any time.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitamo isura igusa. Wayihindura igihe cyose."
          }
        }
      }
    },
    "Choose a file you exported from StarHash's Settings.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitamo dosiye wohereje uhereye ku Igenamiterere rya StarHash."
          }
        }
      }
    },
    "Choose a number": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitamo nimero"
          }
        }
      }
    },
