      }
    },
    "Every flag back to where its rollout puts it": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Buri flag isubira uko rollout yayo ibiteganya"
          }
        }
      }
    },
    "Every payment by day, week, month or year, with a chart.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubwishyu bwose ku munsi, icyumweru, ukwezi cyangwa umwaka, hamwe n'igishushanyo."
          }
        }
      }
    },
    "Every payment in Activity": {
      "localizations": {
