      }
    },
    "Nothing was paid or received in %@.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nta mafaranga yishyuwe cyangwa yakiriwe muri %@."
          }
        }
      }
    },
    "Nothing went out in %@.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nta mafaranga yasohotse muri %@."
          }
        }
      }
    },
    "Nothing. It has no analytics, no advertising and no third-party code that collects data. Request a Feature and the source code open GitHub in your browser, under GitHub's own privacy policy, and every code you dial goes through your phone and your provider, under theirs.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nta na kimwe. Nta isesengura ry'imikoreshereze, nta matangazo, kandi nta kode y'ibindi bigo ikusanya amakuru ibamo. Gusaba ikintu gishya no kureba kode y'inkomoko bifungura GitHub muri mushakisha yawe, hakurikijwe politiki y'ibanga ya GitHub ubwayo, kandi buri kode ukanze inyura muri telefoni yawe no ku mutanga serivisi wawe, hakurikijwe politiki yabo."
          }
        }
      }
    },
    "Notifications": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imenyesha"
          }
        }
      }
    },
