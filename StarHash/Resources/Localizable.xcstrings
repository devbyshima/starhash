        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant qu'aucun n'arrive, StarHash ne marquera pas de lui-même les paiements comme échoués."
          }
        }
      }
    },
    "Update StarHash First": {
