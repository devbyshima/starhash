    "A": {
      "comment": "The period control's letter for all time",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "T"
          }
        }
      }
    },
    "A few words on why StarHash exists": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Impamvu StarHash yakozwe, mu magambo make"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques mots sur la raison d'être de StarHash"
          }
        }
      }
    },
    "A merchant's MoMo code, or a friend's StarHash code.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode ya MoMo y'umucuruzi, cyangwa kode ya StarHash y'inshuti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code MoMo d'un commerçant, ou le code StarHash d'un ami."
          }
        }
      }
    },
    "A note from Shima": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubutumwa buvuye kuri Shima"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mot de Shima"
          }
        }
      }
    },
    "A reminder when a payment is still pending or didn't go through, and your week and month summed up. Choose which ones come, and whether they show amounts, in Settings.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwibutswa iyo ubwishyu bugitegerejwe cyangwa butagenze neza, n'incamake y'icyumweru n'ukwezi kwawe. Hitamo ibyo wakira, n'uko bigaragaza amafaranga cyangwa bitayagaragaza, mu Igenamiterere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel quand un paiement est encore en attente ou n'est pas passé, et le résumé de votre semaine et de votre mois. Choisissez lesquels vous recevez, et s'ils montrent les montants, dans Réglages."
          }
        }
      }
    },
    "A reminder when a payment is still pending,\nand your week and month summed up.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwibutswa iyo ubwishyu bugitegerejwe,\nn'incamake y'icyumweru n'ukwezi kwawe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel quand un paiement est en attente,\net le résumé de votre semaine et de votre mois."
          }
        }
      }
    },
    "About StarHash": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibyerekeye StarHash"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À propos de StarHash"
          }
        }
      }
    },
    "Change your wallet, or set Two SIMs in Settings.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindura konti, cyangwa uhitemo SIM Ebyiri mu Igenamiterere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez de portefeuille, ou choisissez Deux SIM dans Réglages."
          }
        }
      }
    },
    "Transactions keeps each payment by day,\nwith a chart and search.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibikorwa bibika buri bwishyu ku munsi wabwo,\nhamwe n'igishushanyo n'ishakisha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transactions garde chaque paiement par jour,\navec un graphique et une recherche."
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeraho"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter"
