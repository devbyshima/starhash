    "Any MTN or Airtel number, or a merchant\ncode. StarHash knows which is which.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimero iyo ari yo yose ya MTN cyangwa Airtel, cyangwa kode\ny'umucuruzi. StarHash imenya itandukaniro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout numéro MTN ou Airtel, ou un code\ncommerçant. StarHash sait les reconnaître."
          }
        }
      }
    },
    "Any change to this policy will be shown here, with the day it took effect.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Impinduka yose kuri iyi politiki izagaragazwa hano, hamwe n'umunsi yatangiriyeho gukurikizwa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout changement de cette politique sera indiqué ici, avec le jour de son entrée en vigueur."
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
