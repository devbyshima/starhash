      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Amakuru yawe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données"
          }
        }
      }
    },
