            "value": "Kura hejuru"
          }
        }
      }
    },
    "Until one comes, StarHash won't mark payments failed on its own.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mu gihe ubutumwa butaraza, StarHash ntizajya ishyira ubwishyu mu byanze ku bwayo."
          }
        }
      }
    },
    "Update StarHash First": {
      "localizations": {
