    "9:41": {
      "shouldTranslate": false
    },
    "A few words on why StarHash exists": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Impamvu StarHash yakozwe, mu magambo make"
          }
        }
      }
    },
    "A merchant's MoMo code, or a friend's StarHash code.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode ya MoMo y'umucuruzi, cyangwa kode ya StarHash y'inshuti."
          }
        }
      }
    },
    "A note from Shima": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubutumwa buvuye kuri Shima"
          }
        }
      }
    },
    "A reminder when a payment is still pending or didn't go through, and your week and month summed up. Choose which ones come, and whether they show amounts, in Settings.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwibutswa iyo ubwishyu bugitegerejwe cyangwa butagenze neza, n'incamake y'icyumweru n'ukwezi kwawe. Hitamo ibyo wakira, n'uko bigaragaza amafaranga cyangwa bitayagaragaza, mu Igenamiterere."
          }
        }
      }
    },
    "A reminder when a payment is still pending,\nand your week and month summed up.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwibutswa iyo ubwishyu bugitegerejwe,\nn'incamake y'icyumweru n'ukwezi kwawe."
          }
        }
      }
    },
    "About StarHash": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibyerekeye StarHash"
          }
        }
      }
    },
    "Activity": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibikorwa"
          }
        }
      }
    },
    "Activity keeps each payment by day,\nwith a chart and search.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibikorwa bibika buri bwishyu ku munsi wabwo,\nhamwe n'igishushanyo n'ishakisha."
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeraho"
          }
        }
      }
    },
    "Add Again": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeramo nanone"
          }
        }
      }
    },
    "Add Category": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeraho icyiciro"
          }
        }
      }
    },
    "Add Shortcut": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Shortcut"
          }
        }
      }
    },
    "Add StarHash SMS": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeramo StarHash SMS"
          }
        }
      }
    },
    "Add a code": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeraho kode"
          }
        }
      }
    },
    "Add a code you dial often with the + button, and it is a tap away here.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeraho kode ukunze gukanda ukoresheje akabuto +, maze uzajye uyibona hano ukanze rimwe gusa."
          }
        }
      }
    },
    "Add one shortcut and each %@ message\nconfirms its payment, with the fee.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeramo shortcut imwe, maze buri butumwa bwa %@\nbwemeze ubwishyu bwabwo, hamwe n'ikiguzi."
          }
        }
      }
    },
    "Add one shortcut and your MTN MoMo or Airtel Money messages confirm each payment, with its fee and your new balance.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeraho shortcut imwe, maze ubutumwa bwa MTN MoMo cyangwa Airtel Money bwemeze buri bwishyu, hamwe n'ikiguzi cyabwo n'amafaranga asigaye nyuma yabwo."
          }
        }
      }
    },
    "Add what's in a StarHash file to this iPhone": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongera ibiri muri dosiye ya StarHash kuri iyi iPhone"
          }
        }
      }
    },
    "Add your number for your own QR code": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Shyiramo nimero yawe ubone kode yawe ya QR"
          }
        }
      }
    },
    "Add your number to get a QR code others scan to pay you.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Shyiramo nimero yawe ubone kode ya QR abandi basikana kugira ngo bakwishyure."
          }
        }
      }
    },
    "Add your number to get a code others scan to pay you. It stays on your iPhone.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeraho nimero yawe ubone kode abandi basikana bakakwishyura. Iguma kuri iPhone yawe."
          }
        }
      }
    },
    "Added %@. Nothing already here was changed.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hongewemo %@. Nta kintu cyari gisanzwe hano cyahinduwe."
          }
        }
      }
    },
    "Airtime": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ama-inite"
          }
        }
      }
    },
    "Airtime, bundles and bills bought": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ama-inite, interineti na fagitire byaguzwe"
          }
        }
      }
    },
    "Allow StarHash the camera in the Settings app to scan a code, or choose a photo of one.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Emerera StarHash gukoresha kamera muri porogaramu ya Settings kugira ngo usikane kode, cyangwa uhitemo ifoto yayo."
          }
        }
      }
    },
    "Allow StarHash to see your contacts to pay them by name. They stay on your iPhone.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Emerera StarHash kubona abo muvugana kugira ngo ubishyure ukoresheje amazina yabo. Baguma kuri iPhone yawe."
          }
        }
      }
    },
    "Allow StarHash your precise location in the Settings app, so it can tell one till from the next.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muri porogaramu ya Settings, emerera StarHash kumenya neza aho uri, kugira ngo ibashe gutandukanya iduka rimwe n'irindi."
          }
        }
      }
    },
    "Allow notifications": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Emera imenyesha"
          }
        }
      }
    },
    "Already Up to Date": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Byose bisanzwe bihari"
          }
        }
      }
    },
    "Amount": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Amafaranga"
          }
        }
      }
    },
    "Angry": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Urakaye"
          }
        }
      }
    },
    "Any MTN or Airtel number, or a merchant\ncode. StarHash knows which is which.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimero iyo ari yo yose ya MTN cyangwa Airtel, cyangwa kode\ny'umucuruzi. StarHash imenya itandukaniro."
          }
        }
      }
    },
    "Any change to this policy will be shown here, with the day it took effect.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Impinduka yose kuri iyi politiki izagaragazwa hano, hamwe n'umunsi yatangiriyeho gukurikizwa."
          }
        }
      }
    },
    "Anyone with StarHash scans it to pay you. Their iPhone's Camera opens StarHash on it too.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Umuntu wese ufite StarHash ayisikana akakwishyura. Kamera ya iPhone ye nayo ifungura StarHash iyo iyibonye."
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imigaragarire"
          }
        }
      }
    },
    "Are you sure you want to delete all data?": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzi neza ko ushaka gusiba amakuru yose?"
          }
        }
