    },
    "Wait for your next %@ message, or ask someone to text you **RWF**.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegereza ubutumwa bwawe bukurikira bwa %@, cyangwa usabe umuntu akwandikire **RWF**."
          }
        }
      }
    },
    "Waiting for SMS": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitegereje SMS"
          }
        }
      }
    },
    "Waiting for a %@ message to come through": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Dutegereje ubutumwa bwa %@"
          }
        }
      }
    },
    "Waiting for a message": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hategerejwe ubutumwa"
          }
        }
