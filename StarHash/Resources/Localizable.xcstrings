    },
    "English, French or Kinyarwanda, or your iPhone's": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anglais, français ou kinyarwanda, ou celle de votre iPhone"
          }
        },
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Icyongereza, Igifaransa cyangwa Ikinyarwanda, cyangwa urwa iPhone yawe"
          }
        }
      }
    },
    "Enter a Rwandan mobile number: 078, 079, 072 or 073.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Andika nimero ya telefoni yo mu Rwanda: 078, 079, 072 cyangwa 073."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un numéro mobile rwandais : 078, 079, 072 ou 073."
          }
        }
      }
    },
    "Every %@ message confirms its payment.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Buri butumwa bwa %@ bwemeza ubwishyu bwabwo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque message %@ confirme son paiement."
          }
        }
      }
    },
    "Every flag back to where its rollout puts it": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Buri flag isubira uko rollout yayo ibiteganya"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque option revient à son déploiement"
          }
        }
      }
    },
    "Every payment by day, week, month or year, with a chart.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubwishyu bwose ku munsi, icyumweru, ukwezi cyangwa umwaka, hamwe n'igishushanyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque paiement par jour, semaine, mois ou année, avec un graphique."
          }
        }
      }
    },
    "Every payment in Transactions": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubwishyu bwose muri Ibikorwa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
