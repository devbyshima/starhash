            "value": "Sosiyete yawe y'itumanaho"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre opérateur"
          }
        }
      }
    },
    "Your choices": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Amahitamo yawe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos choix"
          }
        }
      }
    },
    "Your codes": {
      "localizations": {
