          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter le raccourci"
          }
        }
      }
    },
    "Add StarHash SMS": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeramo StarHash SMS"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter StarHash SMS"
          }
        }
      }
    },
    "Add a code": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeraho kode"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un code"
          }
        }
      }
    },
    "Add one shortcut and each %@ message\nconfirms its payment, with the fee.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeramo shortcut imwe, maze buri butumwa bwa %@\nbwemeze ubwishyu bwabwo, hamwe n'ikiguzi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un raccourci et chaque message %@\nconfirme son paiement, avec les frais."
          }
        }
      }
    },
    "Add one shortcut and your MTN MoMo or Airtel Money messages confirm each payment, with its fee and your new balance.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeraho shortcut imwe, maze ubutumwa bwa MTN MoMo cyangwa Airtel Money bwemeze buri bwishyu, hamwe n'ikiguzi cyabwo n'amafaranga asigaye nyuma yabwo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un raccourci et vos messages MTN MoMo ou Airtel Money confirment chaque paiement, avec ses frais et votre nouveau solde."
          }
        }
      }
    },
    "Add what's in a StarHash file to this iPhone": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongera ibiri muri dosiye ya StarHash kuri iyi iPhone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter le contenu d'un fichier StarHash à cet iPhone"
          }
        }
      }
    },
    "Added %@. Nothing already here was changed.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hongewemo %@. Nta kintu cyari gisanzwe hano cyahinduwe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ajoutés. Rien de ce qui était déjà là n'a changé."
          }
        }
      }
    },
    "Airtime": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ama-inite"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crédit"
          }
        }
      }
    },
    "Allow StarHash the camera in the Settings app to scan a code, or choose a photo of one.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Emerera StarHash gukoresha kamera muri porogaramu ya Settings kugira ngo usikane kode, cyangwa uhitemo ifoto yayo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'appareil photo pour StarHash dans l'app Réglages pour scanner un code, ou choisissez-en une photo."
          }
        }
      }
    },
    "Allow StarHash your precise location in the Settings app, so it can tell one till from the next.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muri porogaramu ya Settings, emerera StarHash kumenya neza aho uri, kugira ngo ibashe gutandukanya iduka rimwe n'irindi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez votre position exacte pour StarHash dans l'app Réglages, pour qu'il distingue une caisse de la suivante."
          }
        }
      }
    },
    "Allow notifications": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Emera imenyesha"
          }
        },
        "fr": {
