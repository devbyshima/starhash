{
  "name": "starhash-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "schema": "wrangler d1 execute starhash --remote --file schema.sql",
    "count": "wrangler d1 execute starhash --remote --command \"$(grep -v '^--' stats/count.sql)\"",
    "daily": "wrangler d1 execute starhash --remote --command \"$(grep -v '^--' stats/daily.sql)\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
