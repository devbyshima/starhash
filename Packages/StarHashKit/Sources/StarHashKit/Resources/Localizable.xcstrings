{
  "sourceLanguage": "en",
  "strings": {
    " Balance %@.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": " Amafaranga asigaye ni %@."
          }
        }
      }
    },
    "%@ %@.": {
      "shouldTranslate": false
    },
    "%@ and %@ %@.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, kandi %@ %@."
          }
        }
      }
    },
    "%@ is still pending. Mark it as confirmed or failed.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: biracyategerejwe. Hitamo niba byemejwe cyangwa byanze."
          }
        }
      }
    },
    "%@ message": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "ubutumwa bwa %@"
          }
        }
      }
    },
    "%@ sent you %@.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ yakoherereje %2$@."
          }
        }
      }
    },
    "%@ sent you money.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yakoherereje amafaranga."
          }
        }
      }
    },
    "%@ to %@": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kuri %@"
          }
        }
      }
    },
    "%@ to %@ went through.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubwishyu bwa %1$@ kuri %2$@ bwagenze neza."
          }
        }
      }
    },
