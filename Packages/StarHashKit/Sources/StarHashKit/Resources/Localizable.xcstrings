      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "ubwishyu 1"
          }
        }
      }
    },
    "A message from %@ %@, but %@'s come from %@. Don't send any money back. Check your balance first.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubutumwa buvuye kuri %@ %@, ariko ubwa %@ buva kuri %@. Ntugire amafaranga usubiza. Banza urebe amafaranga asigaye."
          }
        }
      }
    },
    "A message that %@ asks for money back. %@ never does. Check your balance before you send anything.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubutumwa %1$@ burasaba ko usubiza amafaranga. %2$@ ntijya ibisaba. Banza urebe amafaranga asigaye mbere yo kohereza ikintu cyose."
          }
        }
      }
    },
    "All Time": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "Igihe cyose"
          }
        }
      }
    },
