    "%@ is still pending. Mark it as confirmed or failed.": {
      "localizations": {
        "rw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: biracyategerejwe. Hitamo niba byemejwe cyangwa byanze."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est encore en attente. Marquez-le comme confirmé ou échoué."
